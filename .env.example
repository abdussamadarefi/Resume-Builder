# ==========================================
# ResumeForge Environment Variables Template
# ==========================================

# 1. Analytics
NEXT_PUBLIC_GA_ID=G-RGT94HGV0Z

# 2. Admin Authentication
# Optional custom secret for signing JWT cookies (defaults to built-in fallback)
ADMIN_JWT_SECRET=resumeforge-default-secure-admin-jwt-secret-key-32-chars-min

# Optional custom fallback bcrypt hash for the 'admin' user (defaults to 'admin123')
# ADMIN_FALLBACK_HASH=$2b$10$BZBL4CQ.Bz5YI44AWHzVBObMmHFcGP..a5N7P7EpmdfmoAY34m06y

# 3. Supabase Database (Optional for Production Admin Users table)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. GitHub Content Sync (Optional: For TopBar One-Click GitHub Commits)
# GITHUB_TOKEN=ghp_yourPersonalAccessToken
# GITHUB_OWNER=abdussamadarefi
# GITHUB_REPO=Resume-Builder
# GITHUB_BRANCH=main
